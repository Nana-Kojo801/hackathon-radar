# Neon connection string (include sslmode=require for Neon)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# OpenAI — the only paid service
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
MAX_ENRICH_PER_RUN=60

# Tavily search API (free tier) for web discovery
SEARCH_API_KEY=tvly-...
MAX_DISCOVERY_PAGES=12

# Protects POST /admin/refresh (send as X-Admin-Token header)
ADMIN_TOKEN=change-me

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://hackathon-radar.pages.dev

# Unlocks the personal /me endpoints (saved hackathons, notes, email settings).
# Each device enters it once in the app's Settings. Falls back to ADMIN_TOKEN.
PERSONAL_KEY=change-me-too

# Email alerts (app/notify.py) via Resend
RESEND_API_KEY=re_...
NOTIFY_EMAIL=you@example.com
# NOTIFY_FROM=Hackathon Radar <onboarding@resend.dev>
# APP_URL=https://hackathon-radar.<you>.workers.dev
