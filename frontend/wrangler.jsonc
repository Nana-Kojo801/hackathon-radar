// Cloudflare Worker config. The site is static assets (dist/), plus a small
// script (worker/index.ts) that only runs for "/" and "/h/<id>" to add link
// preview tags. "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "hackathon-radar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/h/*"]
  },
  "vars": {
    // Where app/snapshot.py publishes the data (GitHub Pages).
    "SNAPSHOT_URL": "https://nana-kojo801.github.io/hackathon-radar",
    // The API, which starts the scheduled refresh on GitHub (POST /schedule/tick).
    "API_URL": "https://hackathon-radar-api-cob5.onrender.com"
  },
  // Start each 6-hourly refresh on time (GitHub's own schedule runs hours late), and try again
  // half an hour later in case the free API was too slow to wake. A second call does nothing.
  "triggers": { "crons": ["17 */6 * * *", "47 */6 * * *"] },
  "observability": { "enabled": true }
}
